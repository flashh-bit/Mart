# Auth Configuration
ADMIN_EMAIL="admin@yourdomain.com"
# Generate this hash by running `npm run hash-password`
ADMIN_PASSWORD_HASH="paste_your_generated_hash_here"
# Generate a secure random string for signing session JWTs
SESSION_SECRET="your_very_long_secure_random_string_here"

# Supabase Configuration
# Found in Supabase Dashboard -> Settings -> API -> Project URL
SUPABASE_URL="https://your-project-id.supabase.co"
# Found in Supabase Dashboard -> Settings -> API -> service_role secret
SUPABASE_SERVICE_ROLE_KEY="sb_secret_your_service_role_key_here"

# Optional Health Check ping URL
# Used by GitHub Actions to prevent server from sleeping
# KEEPALIVE_URL="https://your-domain.com/api/health"
